{
  "name": "sjats-cfo-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Fractional CFO dashboard and decision platform for SJ Advisory & Tax",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server/main.ts",
    "demo": "npm run build && SEED_DEMO=1 node src/server/main.ts",
    "portal-example": "node examples/portal-host/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "examples": "node scripts/make-examples.ts"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@types/node": "^22.18.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "esbuild": "^0.28.0", "typescript": "^5.9.0" }
}
