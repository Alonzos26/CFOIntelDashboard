# Copy to .env (never commit). All values here are placeholders.
NODE_ENV=production
PORT=4300
DB_PATH=./data/cfo.sqlite
COOKIE_SECURE=true
SESSION_TTL_MINUTES=480
EMBEDDED_SESSION_TTL_MINUTES=60
# Shared with the SJATS Client Portal backend for launch tokens. 32+ random characters. Store in a secret manager.
PORTAL_SSO_SECRET=
PORTAL_ISSUER=sjats-client-portal
# Origins allowed to frame the app (CSP frame-ancestors), comma-separated.
EMBED_ALLOWED_ORIGINS=https://portal.sjats.example
# Demo only. Ignored (and refused) when NODE_ENV=production.
# SEED_DEMO=1

# Address clients use to reach the dashboard (or the client portal page that embeds it). Used for the link in the monthly email draft.
PUBLIC_URL=
